// RahulEventsNight - MongoDB (Production)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model AdminUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  category    String
  subCategory String?
  description String
  longDesc    String?
  coverImage  String
  gallery     String?
  eventDate   String?
  location    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String
  type        String
  url         String
  thumbnail   String?
  youtubeId   String?
  description String?
  eventDate   String?
  location    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Artist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  specialty String?
  bio       String?
  avatar    String
  phone     String?
  social    String?
  order     Int      @default(0)
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String
  youtubeId   String
  thumbnail   String?
  description String?
  duration    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UpcomingEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String
  eventDate   String
  eventTime   String?
  venue       String
  city        String?
  description String?
  coverImage  String?
  bookingOpen Boolean  @default(true)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  company   String?
  avatar    String?
  rating    Int      @default(5)
  message   String
  event     String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  bio       String?
  avatar    String
  social    String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String
  eventDate String?
  eventType String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}
